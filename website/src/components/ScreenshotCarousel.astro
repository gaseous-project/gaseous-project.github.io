---
// src/components/ScreenshotCarousel.astro
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: Array<{ src: string; alt: string }>; 
}

const { images } = Astro.props;
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screenshots/*.{jpeg,jpg,png,gif,webp,svg,PNG,JPG}');
---

<div class="carousel-wrapper">
  {/* Left Arrow Button */}
  <button class="nav-btn prev-btn" aria-label="Previous slide" type="button">‹</button>
  
  {/* Main Horizontal Container */}
  <div class="screenshot-carousel">
    <div class="carousel-track">
      {images.map((img) => {
        const imageLoader = allImages[img.src];
        if (!imageLoader) return null;
        
        return (
          <div class="carousel-slide">
            <button class="modal-trigger" type="button" aria-label={`Zoom view of ${img.alt}`}>
              <Image src={imageLoader()} alt={img.alt} format="webp" quality="mid" class="carousel-img" />
            </button>
          </div>
        );
      })}
    </div>
  </div>

  {/* Right Arrow Button */}
  <button class="nav-btn next-btn" aria-label="Next slide" type="button">›</button>

  {/* Modal Dialog Backdrop */}
  <dialog class="carousel-modal">
    <div class="modal-content-wrapper">
      <button class="close-modal" aria-label="Close image modal" type="button">×</button>
      <img src="" alt="" class="modal-img" />
    </div>
  </dialog>
</div>

<script>
  function setupCarousels() {
    const wrappers = document.querySelectorAll('.carousel-wrapper');
    
    wrappers.forEach(wrapper => {
      const carousel = wrapper.querySelector('.screenshot-carousel') as HTMLElement;
      const prevBtn = wrapper.querySelector('.prev-btn');
      const nextBtn = wrapper.querySelector('.next-btn');
      const triggers = wrapper.querySelectorAll('.modal-trigger');
      const modal = wrapper.querySelector('.carousel-modal') as HTMLDialogElement;
      const modalImg = modal?.querySelector('.modal-img') as HTMLImageElement;
      const closeModal = modal?.querySelector('.close-modal');

      if (!carousel) return;

      // Handle Left and Right Button Scrolling
      prevBtn?.addEventListener('click', () => {
        carousel.scrollBy({ left: -400, behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        carousel.scrollBy({ left: 400, behavior: 'smooth' });
      });

      // Handle Modal Zoom Triggers
      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const imgInside = trigger.querySelector('.carousel-img') as HTMLImageElement;
          if (modal && modalImg && imgInside) {
            modalImg.src = imgInside.currentSrc || imgInside.src;
            modalImg.alt = imgInside.alt;
            modal.showModal();
          }
        });
      });

      // Close Modal logic
      closeModal?.addEventListener('click', () => modal.close());
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
      });
    });
  }

  // Initialize on page load and on Starlight page transitions (SPA-mode updates)
  setupCarousels();
  document.addEventListener('astro:after-swap', setupCarousels);
</script>

<style>
  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin: 1.5rem 0;
  }

  .screenshot-carousel {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    width: 100%;
    scrollbar-width: none; /* Hide scrollbars for cleaner aesthetic */
    -webkit-overflow-scrolling: touch;
  }

  .screenshot-carousel::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    display: flex;
    gap: 1.25rem;
    padding: 0.5rem;
  }

  .carousel-slide {
    scroll-snap-align: start;
    flex: 0 0 75%; /* Show 3/4 of a slide to indicate scrollability */
    max-width: 500px;
  }

  .modal-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: zoom-in;
    width: 100%;
    display: block;
    transition: transform 0.2s ease-in-out;
  }

  .modal-trigger:hover {
    transform: scale(1.015);
  }

  .carousel-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: var(--sl-shadow-md);
    border: 1px solid var(--sl-color-gray-5);
  }

  /* Navigation Arrow Buttons styling */
  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text-invert);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--sl-shadow-sm);
    transition: background 0.2s;
  }

  .nav-btn:hover {
    background: var(--sl-color-gray-6);
  }

  .prev-btn { left: -1.25rem; }
  .next-btn { right: -1.25rem; }

  /* Modal Lightbox styling */
  .carousel-modal {
    border: none;
    background: rgba(0, 0, 0, 0.85);
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    padding: 0;
    justify-content: center;
    align-items: center;
  }

  .carousel-modal[open] {
    display: flex;
  }

  .modal-content-wrapper {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
  }

  .modal-img {
    max-width: 100%;
    max-height: 85vh;
    border-radius: 6px;
    object-fit: contain;
  }

  .close-modal {
    position: absolute;
    top: -3rem;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 2.5rem;
    cursor: pointer;
  }
</style>
